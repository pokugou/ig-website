Options +FollowSymLinks
RewriteEngine On

# Fix broken cached filesystem-path redirect URLs (from old .htaccess bug)
# e.g., /home/igrodplan/ig-rod.jp/public_html/strixedge/.html → /strixedge.html
RewriteRule ^home/igrodplan/ig-rod\.jp/public_html/([^/]+)/\.html$ /$1.html [L,R=301]
RewriteRule ^home/igrodplan/ig-rod\.jp/public_html/([^/]+)\.html$ /$1.html [L,R=301]

# Clean URLs: /ika → ika.html, /strixedge → strixedge.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^./]+)$ $1.html [L]

# Custom 404 page
ErrorDocument 404 /404.html

# HTML: always fetch fresh from server (prevents stale-cache navigation bug)
<FilesMatch "\.(html|htm)$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
